@model HerbalWellnessCenter.Models.Bed

@{
    ViewData["Title"] = "Thêm Giường & Phòng Trị Liệu Mới - Herbal Wellness Center";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .admin-wrapper {
        background-color: #f8fafc;
        min-height: 100vh;
        padding: 40px 0;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .header-title {
        font-family: 'Playfair Display', serif;
        color: #1e3a1b;
        letter-spacing: -0.5px;
    }
    .card-custom {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        background: #ffffff;
    }
    .form-control:focus, .form-select:focus {
        border-color: #1e3a1b;
        box-shadow: 0 0 0 0.25rem rgba(30, 58, 27, 0.15);
    }
    .btn-success-custom {
        background-color: #1e3a1b;
        color: white;
        border: none;
        transition: all 0.2s ease;
    }
    .btn-success-custom:hover {
        background-color: #2c5228;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(30, 58, 27, 0.25);
    }
    .info-box {
        background: #f0fdf4;
        border-left: 4px solid #16a34a;
        border-radius: 8px;
        padding: 16px;
    }
</style>

<div class="admin-wrapper">
    <div class="container" style="max-width: 900px;">
        
        <!-- HEADER TIÊU ĐỀ & ĐIỀU HƯỚNG -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom gap-3">
            <div>
                <h2 class="fw-bold header-title mb-1 fs-3">
                    <i class="bi bi-hospital-fill text-success me-2"></i> THÊM GIƯỜNG / PHÒNG TRỊ LIỆU MỚI
                </h2>
                <p class="text-muted mb-0 small">Thiết lập không gian cơ sở vật chất & bồn ngâm thảo dược chuẩn 5 sao • Herbal Wellness Center</p>
            </div>
            <div>
                <a asp-action="Beds" class="btn btn-outline-secondary fw-semibold px-4 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay Lại Danh Sách
                </a>
            </div>
        </div>

        <!-- THÔNG BÁO LỖI MODEL (NẾU CÓ) -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Vui lòng kiểm tra lại các trường thông tin bên dưới.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

        <!-- FORM NHẬP LIỆU CHÍNH -->
        <div class="card card-custom p-4 p-md-5 mb-4 border-top border-success border-4">
            <form asp-action="CreateBed" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div class="info-box mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <i class="bi bi-info-circle-fill text-success fs-4 mt-1"></i>
                        <div>
                            <h6 class="fw-bold text-success mb-1">Quy tắc đặt mã hiệu cơ sở vật chất</h6>
                            <p class="small text-muted mb-0">Mã giường nên viết ngắn gọn, rõ ràng theo định dạng khu vực (VD: <strong>G-01</strong> cho giường thường, <strong>VIP-01</strong> cho phòng trị liệu cao cấp hoặc <strong>BON-01</strong> cho bồn ngâm thảo dược).</p>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-success small text-uppercase">Số Hiệu Giường / Bồn <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-tag-fill"></i></span>
                            <input type="text" asp-for="BedNumber" class="form-control form-control-lg rounded-end-3 fs-6 border-start-0" required placeholder="Ví dụ: G-04 hoặc VIP-02" />
                        </div>
                        <span asp-validation-for="BedNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-success small text-uppercase">Tầng / Phân Khu Trị Liệu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-layers-fill"></i></span>
                            <input type="text" asp-for="FloorLevel" class="form-control form-control-lg rounded-end-3 fs-6 border-start-0" value="Tầng 1 - Khu Thảo Dược" required placeholder="Ví dụ: Tầng 1 - Khu Thảo Dược" />
                        </div>
                        <span asp-validation-for="FloorLevel" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold text-success small text-uppercase">Tên Phòng Trị Liệu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-door-open-fill"></i></span>
                            <input type="text" asp-for="RoomName" class="form-control form-control-lg rounded-end-3 fs-6 border-start-0" value="Phòng Đông Y Thảo Dược 1" required placeholder="Ví dụ: Phòng Đông Y Thảo Dược 1" />
                        </div>
                        <span asp-validation-for="RoomName" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <!-- NÚT HÀNH ĐỘNG -->
                <div class="d-flex justify-content-end align-items-center gap-3 pt-4 mt-4 border-top">
                    <a asp-action="Beds" class="btn btn-light rounded-pill px-4 fw-semibold text-secondary">Hủy Bỏ</a>
                    <button type="submit" class="btn btn-success-custom fw-bold px-5 py-3 rounded-pill shadow-sm">
                        <i class="bi bi-check2-circle me-2 fs-5 align-middle"></i> Lưu & Kích Hoạt Giường Mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}